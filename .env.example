# Copy this file to `.env` and adjust for your machine. Never commit .env.

# --- Core ---
# Set a long random value in production, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=dev-secret-change-me

# APP_ENV=default | test
APP_ENV=default

# --- Database ---
# SQLite (dev, zero setup):
# DATABASE_URL=sqlite:///portal.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/campus_portal

# --- Email ---
# console = capture emails in the in-app mailbox at /dev/mailbox (development)
# smtp    = send real emails through an SMTP server (production)
MAIL_MODE=console
MAIL_FROM="Placement Portal <no-reply@campusportal.local>"

# Used only when MAIL_MODE=smtp:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_USE_TLS=true

# --- Resume storage ---
# local = files under instance/uploads/resumes (development)
STORAGE_MODE=local

# --- Sessions ---
# Set to true when serving over HTTPS
SESSION_COOKIE_SECURE=false
